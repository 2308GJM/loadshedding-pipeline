# Copy to .env and fill in. Never commit the real .env file.

# EskomSePush API token — free tier: https://eskomsepush.gumroad.com/l/api
ESP_API_TOKEN=

# Comma-separated EskomSePush area IDs to track schedules for
ESP_AREA_IDS=

# Weather location (defaults to Johannesburg if unset)
WEATHER_LAT=-26.2041
WEATHER_LON=28.0473

# Local (non-Docker) raw data output path. The default in the ingestion
# module is a Linux container path — this override is needed for local
# dev on any OS.
RAW_DATA_DIR=data/raw/loadshedding

# Output path for validated/transformed data (silver layer)
SILVER_DATA_DIR=data/silver/loadshedding

# Optional: "current" or "future" — returns free sample schedule data
# while national stage is 0, so there's real event-shaped data to
# develop against. Leave empty/unset for production runs.
ESP_SCHEDULE_TEST_MODE=current
